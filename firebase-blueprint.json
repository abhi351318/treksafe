{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal trekker details, gear experience, emergency contact and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "city": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "preferredDifficulty": { "type": "string" },
        "preferredTrekTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fitnessLevel": { "type": "string" },
        "typicalDistanceKm": { "type": "number" },
        "maxElevationMeters": { "type": "number" },
        "emergencyContact": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "relationship": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "weatherAlerts": { "type": "boolean" },
            "riskAlerts": { "type": "boolean" },
            "trekReminders": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SavedTrek": {
      "title": "SavedTrek",
      "description": "Saved trek analysis belonging to a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "trekId": { "type": "string" },
        "trekName": { "type": "string" },
        "region": { "type": "string" },
        "date": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "elevation": { "type": "number" },
        "riskScore": { "type": "number" },
        "riskBand": { "type": "string" },
        "temperature": { "type": "number" },
        "rainProbability": { "type": "number" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "trekName", "date", "riskScore"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "UserProfile",
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User document storing profile details"
    },
    "/users/{userId}/savedTreks/{trekRecordId}": {
      "entity": "SavedTrek",
      "schema": {
        "$ref": "#/entities/SavedTrek"
      },
      "description": "Subcollection of saved treks for each user"
    }
  }
}
